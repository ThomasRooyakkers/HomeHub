# Copy this file to .env and fill in your values before running Docker Compose.

# Host port used by docker-compose.yml
APP_PORT=5080

# Port the Node backend listens on internally (nginx proxies /api/ to this)
PORT=3001

# Root directory for persistent data inside the container
DATA_DIR=/data

# Directory where uploaded files are stored
UPLOADS_DIR=/data/uploads

# Maximum upload size in megabytes
UPLOAD_MAX_MB=10

# Allowed CORS origin (leave blank when nginx handles both frontend + backend)
CORS_ORIGIN=

# Authentication
# Generate a strong random secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to true when serving HomeHub over HTTPS
COOKIE_SECURE=false

# Initial admin user created when no users exist yet
ADMIN_USERNAME=admin

# Use a strong random password, at least 20 characters
ADMIN_PASSWORD=

# Optional Cloudflare Tunnel token
CLOUDFLARE_TUNNEL_TOKEN=
