# Port the Node backend listens on (nginx proxies /api/ to this)
PORT=3001

# Root directory for all persistent data
DATA_DIR=/data

# Directory where uploaded files are stored (defaults to DATA_DIR/uploads)
UPLOADS_DIR=/data/uploads

# Maximum upload size in megabytes
UPLOAD_MAX_MB=10

# Allowed CORS origin for the API (used when running backend standalone, e.g. in dev)
# Leave blank when nginx serves both frontend and backend from the same origin
CORS_ORIGIN=
